index 0dd830b8e..55aa8a2e0 100644
--- a/src/drivers/display/drm/lv_linux_drm.c
+++ b/src/drivers/display/drm/lv_linux_drm.c
@@ -93,6 +93,7 @@ static int drm_get_conn_props(drm_dev_t * drm_dev);
 static int drm_add_plane_property(drm_dev_t * drm_dev, const char * name, uint64_t value);
 static int drm_add_crtc_property(drm_dev_t * drm_dev, const char * name, uint64_t value);
 static int drm_add_conn_property(drm_dev_t * drm_dev, const char * name, uint64_t value);
+static void drm_add_plane_max_zpos(drm_dev_t * drm_dev);
 static int find_plane(drm_dev_t * drm_dev, unsigned int fourcc, uint32_t * plane_id, uint32_t crtc_id,
                       uint32_t crtc_idx);
 static int drm_find_connector(drm_dev_t * drm_dev, int64_t connector_id);
@@ -437,6 +438,31 @@ static int drm_add_conn_property(drm_dev_t * drm_dev, const char * name, uint64_t
     return 0;
 }
 
+static void drm_add_plane_max_zpos(drm_dev_t * drm_dev)
+{
+    uint32_t i;
+
+    for(i = 0; i < drm_dev->count_plane_props; ++i) {
+        drmModePropertyPtr prop = drm_dev->plane_props[i];
+
+        if(lv_strcmp(prop->name, "zpos") != 0)
+            continue;
+        if(prop->flags & DRM_MODE_PROP_IMMUTABLE) {
+            LV_LOG_INFO("drm: plane zpos is immutable");
+            return;
+        }
+        if((prop->flags & DRM_MODE_PROP_RANGE) && prop->count_values >= 2) {
+            uint64_t zpos = prop->values[1];
+
+            if(drm_add_plane_property(drm_dev, "zpos", zpos) == 0)
+                LV_LOG_INFO("drm: set plane zpos to %" PRIu64, zpos);
+            return;
+        }
+    }
+
+    LV_LOG_INFO("drm: plane has no configurable zpos property");
+}

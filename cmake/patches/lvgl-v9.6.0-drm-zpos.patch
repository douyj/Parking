         drm_add_crtc_property(drm_dev, "MODE_ID", drm_dev->blob_id);
         drm_add_crtc_property(drm_dev, "ACTIVE", 1);
 
+        drm_add_plane_max_zpos(drm_dev);
         flags |= DRM_MODE_ATOMIC_ALLOW_MODESET;
 
         first = 0;

[Unit]
Description=Backup Parking Backend SQLite
After=parking-backend.service

[Service]
Type=oneshot
User=dyj
Group=dyj
ExecStart=/home/dyj/project/Parking/backend/.venv/bin/python /home/dyj/project/Parking/backend/scripts/backup_database.py --database /home/dyj/project/Parking/backend/data/parking_backend.db --output /home/dyj/project/Parking/backend/backups --retention-days 7
NoNewPrivileges=true
PrivateTmp=true
